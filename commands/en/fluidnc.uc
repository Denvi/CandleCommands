[
    {
        "hint": "Send from\nSD card",
        "imageName": "*upload.png",
        "imageBase64": "",
        "type": "1",
        "code": "script.importExtension(\"qt.core\");\nscript.importExtension(\"qt.network\");\nscript.importExtension(\"qt.widgets\");\n\nconst codec = QTextCodec.codecForMib(106);\n\n(function () {\n    if (app.device.state != 1) {\n        QMessageBox.critical(app.window, \"\", \"Device not ready\");\n        return;\n    }\n\n    const fluidUrl = 'http://' + app.settings.telnetAddress;\n    if (!fluidUrl) {\n        QMessageBox.critical(app.window, \"\", \"No FluidNC connection specified\");\n        return;\n    }\n\n    if (!app.saveFile()) {\n        QMessageBox.critical(app.window, \"\", \"File should be saved before send\");\n        return;\n    }\n\n    const sourceFilePath = app.program.fileName;\n    if (!sourceFilePath) {\n        QMessageBox.critical(app.window, \"\", \"No file to send\");\n        return;\n    }\n\n    const targetFilePath = new QFileInfo(sourceFilePath).fileName();\n\n    app.resetFile();\n\n    if (!uploadFile(fluidUrl, sourceFilePath, targetFilePath)) {\n        QMessageBox.critical(app.window, \"\", \"Error uploading file\");\n        return;\n    }\n\n    app.device.sendCommands('$SD/RUN=' + targetFilePath);\n})();\n\nfunction uploadFile(fluidUrl, sourceFilePath, targetFilePath) {\n    const file = new QFile(sourceFilePath);\n    if (!file.open(QIODevice.ReadOnly)) {\n        print('Error opening file');\n        return false;\n    }\n\n    const manager = new QNetworkAccessManager();\n    const request = new QNetworkRequest(new QUrl(fluidUrl + '/upload'));\n\n    const body = codec.fromUnicode('--WebAppBoundary\\r\\nContent-Disposition: form-data; name=\"file\"; filenname=\"' + targetFilePath + '\"\\r\\nContent-Type: application/octet-stream\\r\\n\\r\\n');\n    body.append(file.readAll());\n    body.append(codec.fromUnicode('\\r\\n--WebAppBoundary--\\r\\n'));\n\n    request.setRawHeader(codec.fromUnicode('Content-Type'), codec.fromUnicode('multipart/form-data; boundary=WebAppBoundary'));\n    request.setRawHeader(codec.fromUnicode('Content-Length'), codec.fromUnicode(body.size()));\n\n    const progressDialog = new QProgressDialog(\"Uploading file...\", \"Cancel\", 0, 0, app.window);\n\n    const progressBar = new QProgressBar();\n    progressBar.minimum = 0;\n    progressBar.maximum = body.size();\n    progressBar.textVisible = false;    \n\n    progressDialog.setBar(progressBar);\n    progressDialog.setFixedHeight(progressDialog.sizeHint.height());\n    progressDialog.canceled.connect(function () {\n        reply.abort();\n    });\n\n    const reply = manager.post(request, body);\n    \n    reply.uploadProgress.connect(function (bytesSent, bytesTotal) {\n        progressBar.value = bytesSent;\n    });\n    \n    reply.finished.connect(function () {\n        progressDialog.close();\n    });\n\n    progressDialog.exec();\n\n    if (reply.lastError() != QNetworkReply.NoError) {\n        print('Error uploading file: ' + codec.toUnicode(reply.readAll()));\n        return false;\n    }\n\n    return true;\n}"
    }
]